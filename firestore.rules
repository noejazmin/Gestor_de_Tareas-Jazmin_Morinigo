rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function hasOnlyAllowedFields(data) {
      return data.keys().hasOnly([
        'title',
        'description',
        'completed',
        'userId',
        'createdAt',
        'updatedAt',
        'priority',
        'dueDate',
        'order'
      ]);
    }

    function hasValidBaseFields(data) {
      return data.title is string
        && data.title.size() > 0
        && data.description is string
        && data.description.size() > 0
        && data.completed is bool
        && data.userId is string;
    }

    function hasValidExtraFields(data) {
      return (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is string)
        && (!('order' in data) || data.order is number);
    }

    match /tasks/{taskId} {
      allow read, delete: if isOwner();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && hasOnlyAllowedFields(request.resource.data)
        && hasValidBaseFields(request.resource.data)
        && hasValidExtraFields(request.resource.data);

      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && hasOnlyAllowedFields(request.resource.data)
        && hasValidBaseFields(request.resource.data)
        && hasValidExtraFields(request.resource.data);
    }
  }
}