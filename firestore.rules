rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLAS DE SEGURIDAD PARA LA COLECCIÓN DE TAREAS (tasks):
    // 
    // COMENTARIOS DIDÁCTICOS:
    // 1. Cada tarea tiene un campo 'userId' que indica a quién le pertenece.
    // 2. Un usuario autenticado (request.auth != null) solo puede:
    //    - Crear una tarea si le asigna su propio UID (request.resource.data.userId == request.auth.uid).
    //    - Leer, actualizar o eliminar la tarea si el documento ya guardado contiene su UID (resource.data.userId == request.auth.uid).
    // 3. Validamos opcionalmente 'priority', 'dueDate' y 'order' si están presentes en la petición
    //    para asegurar la integridad de datos manteniendo compatibilidad con documentos antiguos.
    
    match /tasks/{taskId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && (!('priority' in request.resource.data) || request.resource.data.priority in ['low', 'medium', 'high'])
        && (!('dueDate' in request.resource.data) || request.resource.data.dueDate == null || request.resource.data.dueDate is string)
        && (!('order' in request.resource.data) || request.resource.data.order is number);
        
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid // Impedimos transferencias de propiedad
        && (!('priority' in request.resource.data) || request.resource.data.priority in ['low', 'medium', 'high'])
        && (!('dueDate' in request.resource.data) || request.resource.data.dueDate == null || request.resource.data.dueDate is string)
        && (!('order' in request.resource.data) || request.resource.data.order is number);
    }
  }
}
